<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- ===== HERO ===== -->
<section class="features-hero section" style="padding-bottom:40px;">
  <div class="hero-bg">
    <div class="hero-gradient-orb orb-1"></div>
    <div class="hero-gradient-orb orb-3"></div>
  </div>
  <div class="container" style="position:relative;z-index:2;">
    <div class="badge" style="margin-bottom:24px;">Architecture &amp; Implementation</div>
    <h1>About the <span class="text-gradient">Technology</span></h1>
    <p style="font-size:18px;color:var(--text-muted);max-width:640px;line-height:1.7;margin-top:16px;">
      Discover the sophisticated AI pipeline that powers GenreAI — from raw audio waveforms to high-precision music genre classification in milliseconds.
    </p>
  </div>
</section>

<!-- ===== AI PIPELINE ===== -->
<section class="section-sm">
  <div class="container">
    <div class="section-header reveal">
      <div class="badge" style="margin-bottom:16px;">How It Works</div>
      <h2>The AI <span class="text-gradient">Pipeline</span></h2>
      <p>Every audio file goes through a sophisticated multi-stage pipeline before a genre prediction is made.</p>
    </div>
    <div class="pipeline-flow">
      <div class="pipeline-step glass-card reveal">
        <div class="pipeline-step-num">01</div>
        <div class="pipeline-step-icon"><span class="material-symbols-outlined">upload_file</span></div>
        <h4>Audio Input</h4>
        <p>Upload your audio file in any supported format — MP3, WAV, OGG, FLAC, or M4A.</p>
      </div>
      <div class="pipeline-connector"><span class="material-symbols-outlined">arrow_forward</span></div>
      <div class="pipeline-step glass-card reveal">
        <div class="pipeline-step-num">02</div>
        <div class="pipeline-step-icon"><span class="material-symbols-outlined">tune</span></div>
        <h4>Preprocessing</h4>
        <p>Audio is resampled to 22,050 Hz, normalized, and trimmed to a consistent duration for analysis.</p>
      </div>
      <div class="pipeline-connector"><span class="material-symbols-outlined">arrow_forward</span></div>
      <div class="pipeline-step glass-card reveal">
        <div class="pipeline-step-num">03</div>
        <div class="pipeline-step-icon"><span class="material-symbols-outlined">graphic_eq</span></div>
        <h4>Mel Spectrogram</h4>
        <p>FFT converts the waveform to frequency domain, then Mel-scaling and log compression create a visual spectrogram.</p>
      </div>
      <div class="pipeline-connector"><span class="material-symbols-outlined">arrow_forward</span></div>
      <div class="pipeline-step glass-card reveal">
        <div class="pipeline-step-num">04</div>
        <div class="pipeline-step-icon"><span class="material-symbols-outlined">psychology</span></div>
        <h4>CNN Model</h4>
        <p>The spectrogram image feeds into our trained Convolutional Neural Network to identify genre-specific patterns.</p>
      </div>
      <div class="pipeline-connector"><span class="material-symbols-outlined">arrow_forward</span></div>
      <div class="pipeline-step glass-card reveal">
        <div class="pipeline-step-num">05</div>
        <div class="pipeline-step-icon"><span class="material-symbols-outlined">check_circle</span></div>
        <h4>Prediction</h4>
        <p>The model outputs confidence scores across all 10 genre classes with the top match highlighted.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== MODEL ARCHITECTURE ===== -->
<section class="section">
  <div class="container">
    <div class="arch-grid">
      <div class="arch-info reveal">
        <div class="badge" style="margin-bottom:16px;">Deep Learning</div>
        <h2 style="font-family:var(--font-heading);font-size:clamp(28px,4vw,42px);font-weight:700;letter-spacing:-1px;margin-bottom:20px;">
          Model <span class="text-gradient">Architecture</span>
        </h2>
        <p style="font-size:15px;color:var(--text-muted);line-height:1.8;margin-bottom:24px;">
          GenreAI uses a <strong style="color:var(--text);">Convolutional Neural Network (CNN)</strong> inspired by the ResNet architecture, specifically adapted for audio spectral image classification. The model treats Mel-spectrograms as grayscale images, learning complex frequency and temporal patterns that define each genre.
        </p>
        <div class="arch-layers">
          <div class="arch-layer">
            <div class="arch-layer-icon"><span class="material-symbols-outlined">input</span></div>
            <div>
              <h5>Input Layer</h5>
              <p>Mel-spectrogram image (128×128 pixels, single channel)</p>
            </div>
          </div>
          <div class="arch-layer">
            <div class="arch-layer-icon"><span class="material-symbols-outlined">layers</span></div>
            <div>
              <h5>Convolutional Blocks</h5>
              <p>Multiple Conv2D layers with Batch Normalization, ReLU activation, and MaxPooling</p>
            </div>
          </div>
          <div class="arch-layer">
            <div class="arch-layer-icon"><span class="material-symbols-outlined">compress</span></div>
            <div>
              <h5>Global Average Pooling</h5>
              <p>Reduces spatial dimensions while preserving learned features</p>
            </div>
          </div>
          <div class="arch-layer">
            <div class="arch-layer-icon"><span class="material-symbols-outlined">hub</span></div>
            <div>
              <h5>Dense Layers</h5>
              <p>Fully connected layers with Dropout (0.3) for regularization</p>
            </div>
          </div>
          <div class="arch-layer">
            <div class="arch-layer-icon"><span class="material-symbols-outlined">output</span></div>
            <div>
              <h5>Output Layer</h5>
              <p>Softmax activation across 10 genre classes for probability distribution</p>
            </div>
          </div>
        </div>
      </div>
      <div class="arch-visual reveal">
        <div class="neural-viz" id="neuralViz">
          <div class="nv-label">Input</div>
          <div class="nv-layer nv-input">
            <span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="nv-connections"></div>
          <div class="nv-label">Conv Block 1</div>
          <div class="nv-layer nv-conv1">
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="nv-connections"></div>
          <div class="nv-label">Conv Block 2</div>
          <div class="nv-layer nv-conv2">
            <span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="nv-connections"></div>
          <div class="nv-label">Dense</div>
          <div class="nv-layer nv-dense">
            <span></span><span></span><span></span><span></span>
          </div>
          <div class="nv-connections"></div>
          <div class="nv-label">Output</div>
          <div class="nv-layer nv-output">
            <span></span><span></span><span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

