<!-- ===== DATASET & TRAINING ===== -->
<section class="section">
  <div class="container">
    <div class="dataset-grid">
      <div class="dataset-info reveal">
        <div class="badge" style="margin-bottom:16px;">Training Data</div>
        <h2 style="font-family:var(--font-heading);font-size:clamp(28px,4vw,42px);font-weight:700;letter-spacing:-1px;margin-bottom:20px;">
          The GTZAN <span class="text-gradient">Dataset</span>
        </h2>
        <p style="font-size:15px;color:var(--text-muted);line-height:1.8;margin-bottom:16px;">
          Our model is trained on the <strong style="color:var(--text);">GTZAN Genre Collection</strong>, one of the most widely used benchmark datasets for music genre recognition research. It was originally collected by George Tzanetakis.
        </p>
        <div class="dataset-stats">
          <div class="ds-stat">
            <span class="ds-stat-val">1,000</span>
            <span class="ds-stat-label">Audio Tracks</span>
          </div>
          <div class="ds-stat">
            <span class="ds-stat-val">10</span>
            <span class="ds-stat-label">Genre Classes</span>
          </div>
          <div class="ds-stat">
            <span class="ds-stat-val">30s</span>
            <span class="ds-stat-label">Per Track</span>
          </div>
          <div class="ds-stat">
            <span class="ds-stat-val">22,050</span>
            <span class="ds-stat-label">Sample Rate (Hz)</span>
          </div>
        </div>
      </div>
      <div class="dataset-genres reveal">
        <h4 style="font-family:var(--font-heading);font-size:16px;font-weight:600;margin-bottom:20px;color:var(--text-muted);">10 Genre Classes</h4>
        <div class="genre-tags-grid">
          <span class="genre-tag gt-blues"><span class="material-symbols-outlined">music_note</span>Blues</span>
          <span class="genre-tag gt-classical"><span class="material-symbols-outlined">piano</span>Classical</span>
          <span class="genre-tag gt-country"><span class="material-symbols-outlined">grass</span>Country</span>
          <span class="genre-tag gt-disco"><span class="material-symbols-outlined">nightlife</span>Disco</span>
          <span class="genre-tag gt-hiphop"><span class="material-symbols-outlined">headphones</span>Hip-Hop</span>
          <span class="genre-tag gt-jazz"><span class="material-symbols-outlined">nights_stay</span>Jazz</span>
          <span class="genre-tag gt-metal"><span class="material-symbols-outlined">electric_bolt</span>Metal</span>
          <span class="genre-tag gt-pop"><span class="material-symbols-outlined">star</span>Pop</span>
          <span class="genre-tag gt-reggae"><span class="material-symbols-outlined">sunny</span>Reggae</span>
          <span class="genre-tag gt-rock"><span class="material-symbols-outlined">whatshot</span>Rock</span>
        </div>
      </div>
    </div>
  </div>
</section>

