<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- ===== HERO + ANALYZER ===== -->
<section class="hero" style="min-height:auto;padding-bottom:60px;">
  <div class="hero-bg">
    <div class="hero-gradient-orb orb-1"></div>
    <div class="hero-gradient-orb orb-2"></div>
  </div>
  <div class="dashboard-layout" style="position:relative;z-index:2;">
    <div class="dashboard-info">
      <div class="badge">
        <span class="material-symbols-outlined" style="font-size:14px">auto_awesome</span>
        Powered by Deep Learning
      </div>
      <h1>Analyze Music<br/><span class="text-gradient">Instantly</span><br/>with Neural Nets</h1>
      <p class="text-muted" style="font-size:17px;max-width:460px;line-height:1.7;">
        High-performance genre classification. Drop your tracks and get sub-second AI analysis with confidence scores.
      </p>
      <div class="dash-hero-features">
        <div class="dash-hero-feat">
          <span class="material-symbols-outlined">speed</span>
          <span>&lt;150ms inference</span>
        </div>
        <div class="dash-hero-feat">
          <span class="material-symbols-outlined">verified</span>
          <span>92.4% accuracy</span>
        </div>
        <div class="dash-hero-feat">
          <span class="material-symbols-outlined">headphones</span>
          <span>5 audio formats</span>
        </div>
      </div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;">
        <div class="system-status-pill" id="systemStatus">
          <span class="status-dot"></span>
          <span>System Ready</span>
        </div>
      </div>
    </div>
    <div>
      <div class="upload-panel">
        <div class="upload-header">
          <div>
            <h3>Advanced Analyzer</h3>
            <p>Supports multi-channel 32-bit audio files</p>
          </div>
          <span class="upload-engine-tag">V2.4 ENGINE</span>
        </div>
        <input type="file" id="audioFileInput" accept=".mp3,.wav,.ogg,audio/mpeg,audio/wav,audio/ogg" style="display:none;"/>
        <div class="drop-zone" id="dropZone">
          <div class="drop-zone-icon">
            <span class="material-symbols-outlined">graphic_eq</span>
          </div>
          <h4 id="dropZoneTitle">Drag to Analyze</h4>
          <p id="dropZoneSubtitle">Upload lossless WAV or MP3 for highest classification precision</p>
          <button class="browse-btn" id="browseBtn">
            <span class="material-symbols-outlined" style="font-size:18px">attachment</span>
            Or <span class="underline-text">Browse Files</span>
          </button>
        </div>
        <div class="ai-loader" id="aiLoader">
          <div class="ai-loader-ring"></div>
          <span class="ai-loader-text">AI is analyzing your audio…</span>
        </div>
        <div class="upload-status">
          <div class="upload-status-left">
            <div class="status-icon-box">
              <span class="material-symbols-outlined" style="font-size:18px">bolt</span>
            </div>
            <div>
              <p class="status-label">Processing Status</p>
              <p class="status-text" id="statusMessage">Listening for input...</p>
            </div>
          </div>
        </div>
        <div class="results-panel" id="resultsContainer">
          <div class="results-header">
            <div class="results-icon">
              <span class="material-symbols-outlined" style="font-size:24px">music_note</span>
            </div>
            <div>
              <h4 class="results-title">
                Analysis Complete
                <span class="material-symbols-outlined">check_circle</span>
              </h4>
            </div>
          </div>
          <div class="results-grid">
            <div class="result-box">
              <p class="result-label">Predicted Genre</p>
              <p class="result-value accent" id="resultGenre">-</p>
            </div>
            <div class="result-box">
              <p class="result-label">Confidence</p>
              <p class="result-value" id="resultConfidence">-</p>
              <div class="confidence-bar-track">
                <div class="confidence-bar-fill" id="confidenceBar"></div>
              </div>
            </div>
          </div>
          <div class="alt-predictions" id="additionalGenres" style="display:none;">
            <p class="alt-predictions-title">Alternative Predictions</p>
            <div class="alt-badges" id="additionalGenresList"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== QUICK STATS ===== -->
<section class="section-sm">
  <div class="container">
    <div class="dash-stats-row">
      <div class="glass-card dash-stat-card reveal">
        <div class="dash-stat-icon"><span class="material-symbols-outlined">verified</span></div>
        <div class="dash-stat-content">
          <span class="dash-stat-value" data-count-to="92.4" data-suffix="%">0%</span>
          <span class="dash-stat-label">Model Accuracy</span>
        </div>
      </div>
      <div class="glass-card dash-stat-card reveal">
        <div class="dash-stat-icon" style="background:rgba(6,182,212,0.12);color:#22d3ee;">
          <span class="material-symbols-outlined">database</span>
        </div>
        <div class="dash-stat-content">
          <span class="dash-stat-value">GTZAN</span>
          <span class="dash-stat-label">Training Dataset</span>
        </div>
      </div>
      <div class="glass-card dash-stat-card reveal">
        <div class="dash-stat-icon" style="background:rgba(244,114,182,0.12);color:#f472b6;">
          <span class="material-symbols-outlined">memory</span>
        </div>
        <div class="dash-stat-content">
          <span class="dash-stat-value">CNN</span>
          <span class="dash-stat-label">ResNet Architecture</span>
        </div>
      </div>
      <div class="glass-card dash-stat-card reveal">
        <div class="dash-stat-icon" style="background:rgba(251,191,36,0.12);color:#fbbf24;">
          <span class="material-symbols-outlined">category</span>
        </div>
        <div class="dash-stat-content">
          <span class="dash-stat-value">10</span>
          <span class="dash-stat-label">Genre Classes</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== HOW IT WORKS ===== -->
<section class="section">
  <div class="container">
    <div class="section-header reveal" style="text-align:center;margin-left:auto;margin-right:auto;">
      <div class="badge" style="margin-bottom:16px;">How It Works</div>
      <h2>Three Simple <span class="text-gradient">Steps</span></h2>
      <p>From audio file to genre prediction in seconds.</p>
    </div>
    <div class="how-steps">
      <div class="how-step glass-card reveal">
        <div class="how-step-num">1</div>
        <div class="how-step-icon"><span class="material-symbols-outlined">upload_file</span></div>
        <h3>Upload</h3>
        <p>Drag and drop or browse for your audio file. We support MP3, WAV, and OGG formats up to 100MB.</p>
      </div>
      <div class="how-step-connector">
        <span class="material-symbols-outlined">trending_flat</span>
      </div>
      <div class="how-step glass-card reveal">
        <div class="how-step-num">2</div>
        <div class="how-step-icon" style="background:rgba(6,182,212,0.12);color:#22d3ee;">
          <span class="material-symbols-outlined">psychology</span>
        </div>
        <h3>Analyze</h3>
        <p>Our CNN extracts Mel-spectrograms and runs deep learning inference to identify genre-specific audio patterns.</p>
      </div>
      <div class="how-step-connector">
        <span class="material-symbols-outlined">trending_flat</span>
      </div>
      <div class="how-step glass-card reveal">
        <div class="how-step-num">3</div>
        <div class="how-step-icon" style="background:rgba(52,211,153,0.12);color:#34d399;">
          <span class="material-symbols-outlined">check_circle</span>
        </div>
        <h3>Results</h3>
        <p>Get the predicted genre with confidence scores, plus alternative genre matches ranked by probability.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== SUPPORTED GENRES ===== -->
<section class="section-sm" style="padding-top:0;">
  <div class="container">
    <div class="section-header reveal" style="text-align:center;margin-left:auto;margin-right:auto;">
      <div class="badge" style="margin-bottom:16px;">Classification</div>
      <h2>Supported <span class="text-gradient">Genres</span></h2>
      <p>Our model classifies audio into 10 established genre categories.</p>
    </div>
    <div class="dash-genres-grid">
      <div class="glass-card dash-genre-card reveal" style="--genre-accent:#60a5fa;">
        <span class="material-symbols-outlined">music_note</span>
        <h4>Blues</h4>
      </div>
      <div class="glass-card dash-genre-card reveal" style="--genre-accent:#c084fc;">
        <span class="material-symbols-outlined">piano</span>
        <h4>Classical</h4>
      </div>
      <div class="glass-card dash-genre-card reveal" style="--genre-accent:#facc15;">
        <span class="material-symbols-outlined">grass</span>
        <h4>Country</h4>
      </div>
      <div class="glass-card dash-genre-card reveal" style="--genre-accent:#f472b6;">
        <span class="material-symbols-outlined">nightlife</span>
        <h4>Disco</h4>
      </div>
      <div class="glass-card dash-genre-card reveal" style="--genre-accent:#f87171;">
        <span class="material-symbols-outlined">headphones</span>
        <h4>Hip-Hop</h4>
      </div>
      <div class="glass-card dash-genre-card reveal" style="--genre-accent:#e8a46d;">
        <span class="material-symbols-outlined">nights_stay</span>
        <h4>Jazz</h4>
      </div>
      <div class="glass-card dash-genre-card reveal" style="--genre-accent:#94a3b8;">
        <span class="material-symbols-outlined">electric_bolt</span>
        <h4>Metal</h4>
      </div>
      <div class="glass-card dash-genre-card reveal" style="--genre-accent:#34d399;">
        <span class="material-symbols-outlined">star</span>
        <h4>Pop</h4>
      </div>
      <div class="glass-card dash-genre-card reveal" style="--genre-accent:#4ade80;">
        <span class="material-symbols-outlined">sunny</span>
        <h4>Reggae</h4>
      </div>
      <div class="glass-card dash-genre-card reveal" style="--genre-accent:#fb923c;">
        <span class="material-symbols-outlined">whatshot</span>
        <h4>Rock</h4>
      </div>
    </div>
  </div>
</section>

<!-- ===== METHODOLOGY ===== -->
<section class="section" style="background:var(--glass-bg);">
  <div class="container">
    <div class="section-header reveal">
      <div class="badge" style="margin-bottom:16px;">Under The Hood</div>
      <h2>Project <span class="text-gradient">Methodology</span></h2>
      <p>Advanced signal processing with state-of-the-art CNNs.</p>
    </div>
    <div class="features-grid">
      <div class="glass-card feature-card reveal">
        <div class="feature-icon"><span class="material-symbols-outlined">waves</span></div>
        <h3>Spectrogram Analysis</h3>
        <p>Converting raw audio into Mel-spectrograms, transforming sound into visual patterns that deep learning models can analyze.</p>
      </div>
      <div class="glass-card feature-card reveal">
        <div class="feature-icon"><span class="material-symbols-outlined">tune</span></div>
        <h3>Feature Extraction</h3>
        <p>Extracting MFCCs, chroma features, and spectral contrast to capture unique sonic signatures of each genre.</p>
      </div>
      <div class="glass-card feature-card reveal">
        <div class="feature-icon"><span class="material-symbols-outlined">bolt</span></div>
        <h3>Real-time Inference</h3>
        <p>Optimized model architecture enables near-instant classification, delivering results in under 150 milliseconds.</p>
      </div>
      <div class="glass-card feature-card reveal">
        <div class="feature-icon"><span class="material-symbols-outlined">security</span></div>
        <h3>Privacy Focused</h3>
        <p>Audio files are processed entirely in-memory. Nothing is stored or logged — your music stays private.</p>
      </div>
      <div class="glass-card feature-card reveal">
        <div class="feature-icon"><span class="material-symbols-outlined">analytics</span></div>
        <h3>Multi-Genre Output</h3>
        <p>Beyond the primary prediction, view confidence scores across all 10 genre classes for comprehensive analysis.</p>
      </div>
      <div class="glass-card feature-card reveal">
        <div class="feature-icon"><span class="material-symbols-outlined">api</span></div>
        <h3>REST API Backend</h3>
        <p>Powered by FastAPI with async request handling for high-throughput, production-grade performance.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="section">
  <div class="cta-section">
    <div class="cta-card reveal">
      <h2>Learn More About Our AI</h2>
      <p>Dive deep into the model architecture, training data, and the full technology stack behind GenreAI.</p>
      <a href="/features" class="btn btn-lg">Explore Technology</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<script src="/js/api.js"></script>
<script src="/js/dashboard.js"></script>
</body>
</html>
